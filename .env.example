# Runtime mode. Local defaults preserve the current browser-only workflow.
MIRAI_APP_MODE=local
MIRAI_PERSISTENCE_MODE=local
MIRAI_AI_ENABLED=false
MIRAI_CANONICAL_URL=http://localhost:3000
MIRAI_ALLOWED_ORIGINS=http://localhost:3000
MIRAI_RELEASE_ID=local

# P01-approved processing envelope. Cloud deployments must not increase these without new evidence.
MIRAI_MAX_SOURCE_EDGE=2048
MIRAI_MAX_SOURCE_PIXELS=4194304
MIRAI_HEAVY_REQUEST_CONCURRENCY=1
MIRAI_REQUEST_TIMEOUT_MS=60000
MIRAI_READINESS_TIMEOUT_MS=3000

# The deterministic fake provider is the default and requires no credentials.
IMAGE_EDIT_PROVIDER=fake
ASSET_GENERATION_PROVIDER=fake

# Browser-safe Supabase settings are required for account access and P04 asset uploads,
# including when testing those routes locally. A publishable key is not a secret.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Wave B account access. The owner list and admin key are server-only and must never use NEXT_PUBLIC_.
MIRAI_AUTH_ENABLED=false
# Invitation-only launch: requires auth, AI off, fake providers and no OpenAI key.
# Allows landing, sign-in/callback, access status and owner access management only.
MIRAI_INVITATION_MODE=false
# To exercise P04 HTTP routes at localhost, set this to true and fill the
# Supabase and owner values. Keep MIRAI_APP_MODE=local and the localhost origin.
# MIRAI_OWNER_EMAILS=owner@example.com
# SUPABASE_SECRET_KEY=

# Wave A synthetic feasibility spike. Disabled by default and never enable with real AI providers.
CLOUD_SPIKE_ENABLED=false
# Keep all other API routes hidden when this branch is deployed as the isolated feasibility service.
CLOUD_SPIKE_ISOLATED_DEPLOYMENT=false
# Set only in the protected Render environment when running the spike; use at least 32 random characters.
# CLOUD_SPIKE_TOKEN=
# Local command inputs for the isolated Supabase proof. Never expose the secret key to browser code.
# CLOUD_SPIKE_CONFIRM=synthetic-only
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# CLOUD_SPIKE_URL=

# Optional real provider configuration. Never commit a real key.
# IMAGE_EDIT_PROVIDER=openai
# OPENAI_API_KEY=
# Replace operations use a low-cost vision planner before image generation.
# OPENAI_EDIT_PLANNER_MODEL=gpt-5-nano-2025-08-07
# OPENAI_IMAGE_MODEL=gpt-image-2
# Balanced defaults for better localized reconstruction. Switch to low/1024 when minimizing cost.
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_MAX_EDGE=1536
# Optional real popup creation for logo marks, icons, and complete images.
# ASSET_GENERATION_PROVIDER=openai
# OPENAI_ASSET_GENERATION_MODEL=gpt-image-2
# OPENAI_ASSET_MAX_BATCHES_PER_SESSION=2

# Smart Extend uses a separate cost-sensitive planner and always generates at low quality.
# OPENAI_EXTEND_PLANNER_MODEL=gpt-5.6-luna
# OPENAI_EXTEND_IMAGE_MODEL=gpt-image-2
# OPENAI_EXTEND_PROVIDER_MAX_EDGE=1536

# Wave D real cloud AI: explicit funding and stage ceilings are always required.
# Hosted deployments additionally require qualification. Authenticated local development
# may keep qualification false with a loopback canonical URL and only loopback allowed origins.
# Bind the development server to 127.0.0.1; this does not qualify Render for real AI.
# Both runtime MIRAI_AI_ENABLED and the service-only ai_control.enabled gate must allow work.
# The database budget is independent of the 25 one-time user welcome credits.
MIRAI_AI_HOST_QUALIFIED=false
# Set reviewed positive worst-case ceilings in integer micro-USD (1 USD = 1,000,000).
# No funded values are supplied by default. Include every planner/image/fidelity stage.
# MIRAI_AI_IMAGE_STAGE_MICROUSD=
# MIRAI_AI_TEXT_STAGE_MICROUSD=
# Adapters use zero automatic retries, 60-second per-call timeouts and 4,096 text-output tokens.
# Requalify the host and ceilings whenever model, quality or supported dimensions change.
